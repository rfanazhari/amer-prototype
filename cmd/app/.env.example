# Required: PostgreSQL connection URL, supplied through the environment.
DATABASE_URL=
# Optional listener address; defaults to :8080.
HTTP_ADDRESS=:8080
# Optional Realtime provider key. Empty keeps Task startup working; setup then returns SESSION_UNAVAILABLE.
OPENAI_API_KEY=
# Optional Realtime model; empty defaults to gpt-realtime-2.1.
OPENAI_REALTIME_MODEL=
# Optional Realtime voice; empty defaults to marin.
OPENAI_REALTIME_VOICE=
# Optional Realtime calls URL; empty defaults to https://api.openai.com/v1/realtime/calls.
OPENAI_REALTIME_URL=
